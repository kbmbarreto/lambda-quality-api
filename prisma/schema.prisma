}

model TestCaseImport {
  id String @id @db.Char(36)
  workspaceId String @map("workspace_id") @db.Char(36)
  projectId String @map("project_id") @db.Char(36)
  fileHash String @map("file_hash") @db.Char(64)
  cases Json
  createdBy String @map("created_by") @db.Char(36)
  createdAt DateTime @map("created_at") @db.DateTime(3)
  project Project @relation(fields:[workspaceId,projectId],references:[workspaceId,id],onDelete:Restrict,onUpdate:NoAction)
  @@unique([workspaceId,projectId,fileHash])
  @@map("test_case_imports")
}

model TestVaultEntry {
  id String @id @db.Char(36)
  workspaceId String @map("workspace_id") @db.Char(36)
  projectId String @map("project_id") @db.Char(36)
  environmentId String? @map("environment_id") @db.Char(36)
  name String @db.VarChar(100)
  encryptedPayload String @map("encrypted_payload") @db.LongText
  keyId String @map("key_id") @db.VarChar(50)
  version Int
  createdBy String @map("created_by") @db.Char(36)
  createdAt DateTime @map("created_at") @db.DateTime(3)
  updatedAt DateTime @map("updated_at") @db.DateTime(3)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(3)
  project Project @relation(fields:[workspaceId,projectId],references:[workspaceId,id],onDelete:Restrict,onUpdate:NoAction)
  environment Environment? @relation(fields:[workspaceId,projectId,environmentId],references:[workspaceId,projectId,id],onDelete:Restrict,onUpdate:NoAction)
  @@unique([workspaceId,projectId,id])
  @@index([workspaceId,projectId,deletedAt,name])
  @@index([workspaceId,projectId,environmentId])
  @@map("test_vault_entries")
}

model TestResultImport {
  id             String    @id @db.Char(36)
  workspaceId    String    @map("workspace_id") @db.Char(36)
  projectId      String    @map("project_id") @db.Char(36)
  testRunId      String    @map("test_run_id") @db.Char(36)
  runVersion     Int       @map("run_version")
  fileName       String    @map("file_name") @db.VarChar(250)
  fileHash       String    @map("file_hash") @db.Char(64)
  items          Json
  createdBy      String    @map("created_by") @db.Char(36)
  createdAt      DateTime  @map("created_at") @db.DateTime(3)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  requestKey     String?   @map("request_key") @db.Char(36)
  requestHash    String?   @map("request_hash") @db.Char(64)
  appliedAt      DateTime? @map("applied_at") @db.DateTime(3)
  appliedVersion Int?      @map("applied_version")
  mappings       Json?
  run            TestRun   @relation(fields: [workspaceId, projectId, testRunId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, projectId, testRunId, requestKey], map: "result_imports_request_key")
  @@index([workspaceId, projectId, testRunId, createdBy], map: "result_imports_scope_idx")
  @@map("test_result_imports")
}
