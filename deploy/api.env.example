# Referência de nomes/valores para a Library LambdaQuality-HML.
# A pipeline gera config/releases/<release>/api.env na VM, com formato raw.
# Não incluir este arquivo preenchido no Git, imagem ou artifact da pipeline.
NODE_ENV=production
DATABASE_DIALECT=mariadb
# Container: localhost é o próprio container. Banco nativo no host Linux:
DB_URL=jdbc:mysql://host.docker.internal:3306/lambdaquality
DB_USERNAME=lambdaquality
DB_PASSWORD=replace-me
# Banco remoto: usar endereço privado real e TLS conforme a infraestrutura.
# DB_SSL_CA_PATH=/run/secrets/database_ca.pem
OTP_HMAC_SECRET=replace-with-at-least-32-random-characters
INVITATION_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
JWT_KEY_ID=lambdaquality-hml
JWT_ISSUER=lambdaquality-api
JWT_AUDIENCE=lambdaquality-client
SENDGRID_API_KEY=replace-me
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=Lambda Quality
CORS_ORIGINS=https://hml.example.com
INVITATION_ACCEPT_URL=https://hml.example.com/invitations/accept
LAMBDAQUALITY_STORAGE_ORACLE_REGION=sa-saopaulo-1
LAMBDAQUALITY_STORAGE_ORACLE_NAMESPACE=replace-me
LAMBDAQUALITY_STORAGE_ORACLE_BUCKET=replace-me
LAMBDAQUALITY_STORAGE_PREFIX=lambdaquality-hml/attachments
LAMBDAQUALITY_STORAGE_ORACLE_TENANCY_OCID=ocid1.tenancy.oc1..replace-me
LAMBDAQUALITY_STORAGE_ORACLE_USER_OCID=ocid1.user.oc1..replace-me
LAMBDAQUALITY_STORAGE_ORACLE_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
# Opcional, para PEM cifrado:
# LAMBDAQUALITY_STORAGE_ORACLE_PRIVATE_KEY_PASSPHRASE=replace-me
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_RETENTION_DAYS=30
WORKSPACE_RATE_LIMIT=120
# Os caminhos das três chaves são fixados pelo Compose em /run/secrets.
# Preservar segredos HMAC, chaves e bucket/prefixo entre releases e rollback.

# Secret na Library: JSON com chaves base64 de 32 bytes; preservar chaves antigas.
TEST_VAULT_ACTIVE_KEY_ID=v1
TEST_VAULT_ENCRYPTION_KEYS=
