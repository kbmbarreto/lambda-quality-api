# Copie para .env e configure os valores; nenhum segredo real neste arquivo.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Selecione o histórico de migrations. Não trocar em um banco já inicializado.
DATABASE_DIALECT=mariadb
DB_URL=jdbc:mysql://127.0.0.1:3306/lambdaquality
DB_USERNAME=lambdaquality
# Senhas com # devem estar entre aspas, para não serem truncadas pelo leitor .env.
DB_PASSWORD='replace-me'
# Alternativa aos campos DB_*: DATABASE_URL=mysql://user:password@host:3306/database
# JWT_SECRET existente é usado como segredo HMAC dos códigos, não para assinar JWT.
JWT_SECRET=replace-with-at-least-32-random-characters
# Opcional: OTP_HMAC_SECRET separado, com pelo menos 32 caracteres.
JWT_PRIVATE_KEY_PATH=.local/keys/private.pem
JWT_PUBLIC_KEY_PATH=.local/keys/public.pem
JWT_KEY_ID=lambdaquality-local
JWT_ISSUER=lambdaquality-api
JWT_AUDIENCE=lambdaquality-client
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_SECONDS=604800
REFRESH_IDLE_TTL_SECONDS=86400
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_COOLDOWN_SECONDS=60
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
SENDGRID_API_KEY=replace-me
# O remetente precisa ser verificado no SendGrid. MAIL_USERNAME também é aceito.
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_FROM_NAME=Lambda Quality
SWAGGER_ENABLED=true
# Lista separada por vírgulas, sem wildcard.
CORS_ORIGINS=http://localhost:4200
# WORKSPACE_RATE_LIMIT descontinuado: operações autenticadas não têm quota por minuto.
INVITATION_TTL_SECONDS=172800
INVITATION_COOLDOWN_SECONDS=60
# Opcional: segredo persistente separado com pelo menos 32 caracteres.
# INVITATION_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
# URL da tela do front, sem query/fragmento. Em produção, HTTPS.
# Se ausente, o e-mail apresenta o token para aceite manual pelo Swagger.
# INVITATION_ACCEPT_URL=http://localhost:4200/invitations/accept
# Anexos/evidências: Oracle OCI Object Storage (necessário para arquivos, sem fallback local).
# Falhas de configuração/PEM/OCI não impedem o início da API; anexos retornam HTTP 503.
# Bucket existente, privado (NoPublicAccess), região e prefixo exclusivos da API.
LAMBDAQUALITY_STORAGE_ORACLE_REGION=sa-saopaulo-1
LAMBDAQUALITY_STORAGE_ORACLE_NAMESPACE=replace-me
LAMBDAQUALITY_STORAGE_ORACLE_BUCKET=lambdaquality-private
LAMBDAQUALITY_STORAGE_PREFIX=lambdaquality/attachments
LAMBDAQUALITY_STORAGE_ORACLE_TENANCY_OCID=ocid1.tenancy.oc1..replace-me
LAMBDAQUALITY_STORAGE_ORACLE_USER_OCID=ocid1.user.oc1..replace-me
LAMBDAQUALITY_STORAGE_ORACLE_FINGERPRINT=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00
# Docker: montar a chave em /run/secrets/oci_api_key.pem, somente leitura.
LAMBDAQUALITY_STORAGE_ORACLE_PRIVATE_KEY_PATH=/run/secrets/oci_api_key.pem
# Opcional, somente se a chave estiver cifrada.
# LAMBDAQUALITY_STORAGE_ORACLE_PRIVATE_KEY_PASSPHRASE=replace-me
# O compartment pode continuar no .env; não é necessário nas chamadas a este bucket.
# LAMBDAQUALITY_STORAGE_ORACLE_COMPARTMENT_OCID=ocid1.compartment.oc1..replace-me
# Caminho usado SOMENTE pela ferramenta de migração dos arquivos antigos.
# ATTACHMENT_STORAGE_PATH=.local/uploads
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_RETENTION_DAYS=30
# Produção: JWT_KEY_ID próprio, chaves externas, HTTPS e remetente verificado.

# Cofre de testes: chaves AES-256 (32 bytes) em base64; nunca guardar no banco.
# Falta de chave mantém a API ativa, mas bloqueia gravação/revelação do cofre (503).
# Gerar sem exibir segredos: npm run setup:vault-key. Validar: npm run vault:check.
TEST_VAULT_ACTIVE_KEY_ID=v1
TEST_VAULT_ENCRYPTION_KEYS=
# Formato JSON: {"v1":"<base64 de 32 bytes>"}; preservar chaves antigas ao rotacionar.
