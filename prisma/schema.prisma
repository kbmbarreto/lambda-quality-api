generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum EmailCodePurpose {
  REGISTRATION
  PASSWORD_RESET
}

model User {
  id                String            @id @db.Char(36)
  email             String            @unique @db.VarChar(254)
  displayName       String            @map("display_name") @db.VarChar(100)
  passwordHash      String            @map("password_hash") @db.VarChar(255)
  status            UserStatus        @default(ACTIVE)
  emailVerifiedAt   DateTime          @map("email_verified_at") @db.DateTime(3)
  passwordChangedAt DateTime          @map("password_changed_at") @db.DateTime(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  sessions          AuthSession[]
  workspaceMembers  WorkspaceMember[]

  @@map("users")
}

model AuthSession {
  id           String         @id @db.Char(36)
  userId       String         @map("user_id") @db.Char(36)
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt    DateTime       @map("expires_at") @db.DateTime(3)
  lastUsedAt   DateTime       @map("last_used_at") @db.DateTime(3)
  revokedAt    DateTime?      @map("revoked_at") @db.DateTime(3)
  revokeReason String?        @map("revoke_reason") @db.VarChar(50)
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokens       RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id                String         @id @db.Char(36)
  sessionId         String         @map("session_id") @db.Char(36)
  tokenHash         String         @unique @map("token_hash") @db.Char(64)
  createdAt         DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt         DateTime       @map("expires_at") @db.DateTime(3)
  consumedAt        DateTime?      @map("consumed_at") @db.DateTime(3)
  revokedAt         DateTime?      @map("revoked_at") @db.DateTime(3)
  replacedByTokenId String?        @map("replaced_by_token_id") @db.Char(36)
  session           AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  successor         RefreshToken?  @relation("RefreshReplacement", fields: [sessionId, replacedByTokenId], references: [sessionId, id], onDelete: NoAction, onUpdate: NoAction)
  predecessors      RefreshToken[] @relation("RefreshReplacement")

  @@unique([sessionId, id])
  @@index([sessionId, expiresAt])
  @@map("refresh_tokens")
}

model EmailChallenge {
  id         String           @id @db.Char(36)
  email      String           @db.VarChar(254)
  purpose    EmailCodePurpose
  codeHash   String           @map("code_hash") @db.Char(64)
  attempts   Int              @default(0)
  eligible   Boolean
  createdAt  DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt  DateTime         @map("expires_at") @db.DateTime(3)
  consumedAt DateTime?        @map("consumed_at") @db.DateTime(3)
  revokedAt  DateTime?        @map("revoked_at") @db.DateTime(3)

  @@index([email, purpose, createdAt])
  @@map("email_challenges")
}

model EmailCodeScope {
  id              String    @id @db.Char(64)
  lastRequestedAt DateTime? @map("last_requested_at") @db.DateTime(3)

  @@map("email_code_scopes")
}

model AuditEvent {
  id            String   @id @db.Char(36)
  workspaceId   String?  @map("workspace_id") @db.Char(36)
  actorUserId   String?  @map("actor_user_id") @db.Char(36)
  action        String   @db.VarChar(80)
  entityType    String   @map("entity_type") @db.VarChar(50)
  entityId      String   @map("entity_id") @db.Char(36)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  correlationId String   @map("correlation_id") @db.Char(36)

  @@index([workspaceId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

model Workspace {
  governanceFrameworks GovernanceFramework[]
  governanceGoals      GovernanceGoal[]
  actionPlans          ActionPlan[]
  id                   String                  @id @db.Char(36)
  name                 String                  @db.VarChar(100)
  slug                 String                  @unique @db.VarChar(80)
  status               String                  @default("ACTIVE") @db.VarChar(20)
  ownerMemberId        String?                 @map("owner_member_id") @db.Char(36)
  createdAt            DateTime                @map("created_at") @db.DateTime(3)
  updatedAt            DateTime                @map("updated_at") @db.DateTime(3)
  members              WorkspaceMember[]       @relation("Membership")
  owner                WorkspaceMember?        @relation("Ownership", fields: [id, ownerMemberId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  roles                Role[]
  groups               WorkspaceGroup[]
  invitations          Invitation[]
  fields               CustomFieldDefinition[]
  tags                 Tag[]
  attachments          Attachment[]
  projects             Project[]

  @@map("workspaces")
}

model WorkspaceMember {
  governanceGoals GovernanceGoal[]
  actionPlans     ActionPlan[]
  id              String           @id @db.Char(36)
  workspaceId     String           @map("workspace_id") @db.Char(36)
  userId          String           @map("user_id") @db.Char(36)
  status          String           @default("ACTIVE") @db.VarChar(20)
  joinedAt        DateTime         @map("joined_at") @db.DateTime(3)
  workspace       Workspace        @relation("Membership", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ownedWorkspaces Workspace[]      @relation("Ownership")
  roles           MemberRole[]
  groups          GroupMember[]
  projects        ProjectMember[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

model Permission {
  id              String           @id @db.Char(36)
  code            String           @unique @db.VarChar(80)
  description     String           @db.VarChar(200)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id             String           @id @db.Char(36)
  workspaceId    String           @map("workspace_id") @db.Char(36)
  name           String           @db.VarChar(100)
  normalizedName String           @map("normalized_name") @db.VarChar(100)
  description    String?          @db.VarChar(500)
  systemRole     Boolean          @map("system_role")
  createdAt      DateTime         @map("created_at") @db.DateTime(3)
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  permissions    RolePermission[]
  members        MemberRole[]
  groups         GroupRole[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, normalizedName])
  @@map("roles")
}

model WorkspaceGroup {
  id             String        @id @db.Char(36)
  workspaceId    String        @map("workspace_id") @db.Char(36)
  name           String        @db.VarChar(100)
  normalizedName String        @map("normalized_name") @db.VarChar(100)
  description    String?       @db.VarChar(500)
  createdAt      DateTime      @map("created_at") @db.DateTime(3)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  members        GroupMember[]
  roles          GroupRole[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, normalizedName])
  @@map("groups")
}

model RolePermission {
  id             String     @id @db.Char(36)
  workspaceId    String     @map("workspace_id") @db.Char(36)
  roleId         String     @map("role_id") @db.Char(36)
  permissionCode String     @map("permission_code") @db.VarChar(80)
  role           Role       @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, roleId, permissionCode])
  @@map("role_permissions")
}

model MemberRole {
  id          String          @id @db.Char(36)
  workspaceId String          @map("workspace_id") @db.Char(36)
  memberId    String          @map("member_id") @db.Char(36)
  roleId      String          @map("role_id") @db.Char(36)
  member      WorkspaceMember @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  role        Role            @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, memberId, roleId])
  @@index([workspaceId, roleId])
  @@map("member_roles")
}

model GroupMember {
  id          String          @id @db.Char(36)
  workspaceId String          @map("workspace_id") @db.Char(36)
  groupId     String          @map("group_id") @db.Char(36)
  memberId    String          @map("member_id") @db.Char(36)
  group       WorkspaceGroup  @relation(fields: [workspaceId, groupId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  member      WorkspaceMember @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, groupId, memberId])
  @@index([workspaceId, memberId])
  @@map("group_members")
}

model GroupRole {
  id          String         @id @db.Char(36)
  workspaceId String         @map("workspace_id") @db.Char(36)
  groupId     String         @map("group_id") @db.Char(36)
  roleId      String         @map("role_id") @db.Char(36)
  group       WorkspaceGroup @relation(fields: [workspaceId, groupId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  role        Role           @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, groupId, roleId])
  @@index([workspaceId, roleId])
  @@map("group_roles")
}

model Invitation {
  id               String    @id @db.Char(36)
  workspaceId      String    @map("workspace_id") @db.Char(36)
  email            String    @db.VarChar(254)
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  status           String    @default("PENDING") @db.VarChar(20)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(3)
  invitedBy        String    @map("invited_by") @db.Char(36)
  acceptedBy       String?   @map("accepted_by") @db.Char(36)
  acceptedAt       DateTime? @map("accepted_at") @db.DateTime(3)
  createdAt        DateTime  @map("created_at") @db.DateTime(3)
  lastSentAt       DateTime  @map("last_sent_at") @db.DateTime(3)
  deliveryStatus   String    @map("delivery_status") @db.VarChar(20)
  deliveryPayload  String?   @map("delivery_payload") @db.Text
  deliveryAttempts Int       @default(0) @map("delivery_attempts")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, email, status])
  @@index([deliveryStatus, lastSentAt])
  @@map("invitations")
}

model CustomFieldDefinition {
  id          String               @id @db.Char(36)
  workspaceId String               @map("workspace_id") @db.Char(36)
  key         String               @db.VarChar(80)
  name        String               @db.VarChar(100)
  description String?              @db.VarChar(500)
  type        String               @db.VarChar(30)
  target      String               @db.VarChar(30)
  required    Boolean
  position    Int
  options     Json
  archivedAt  DateTime?            @map("archived_at") @db.DateTime(3)
  createdAt   DateTime             @map("created_at") @db.DateTime(3)
  updatedAt   DateTime             @map("updated_at") @db.DateTime(3)
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  caseValues  TestCaseFieldValue[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, target, key])
  @@index([workspaceId, archivedAt])
  @@map("custom_field_definitions")
}

model Tag {
  id             String        @id @db.Char(36)
  workspaceId    String        @map("workspace_id") @db.Char(36)
  name           String        @db.VarChar(100)
  normalizedName String        @map("normalized_name") @db.VarChar(100)
  createdAt      DateTime      @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @map("updated_at") @db.DateTime(3)
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  caseTags       TestCaseTag[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, normalizedName])
  @@map("tags")
}

model Attachment {
  evidenceLinks   EvidenceLink[]
  defectLinks     DefectAttachment[]
  id              String               @id @db.Char(36)
  workspaceId     String               @map("workspace_id") @db.Char(36)
  storageKey      String               @unique @map("storage_key") @db.VarChar(100)
  originalName    String               @map("original_name") @db.VarChar(255)
  contentType     String               @map("content_type") @db.VarChar(100)
  sizeBytes       Int                  @map("size_bytes")
  checksum        String               @db.Char(64)
  uploadedBy      String               @map("uploaded_by") @db.Char(36)
  createdAt       DateTime             @map("created_at") @db.DateTime(3)
  deletedAt       DateTime?            @map("deleted_at") @db.DateTime(3)
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  caseAttachments TestCaseAttachment[]

  @@unique([workspaceId, id])
  @@index([workspaceId, deletedAt, createdAt])
  @@map("attachments")
}

model Project {
  governanceGoals GovernanceGoal[]
  defects         Defect[]
  testPlans       TestPlan[]
  testRuns        TestRun[]
  id              String            @id @db.Char(36)
  workspaceId     String            @map("workspace_id") @db.Char(36)
  key             String            @db.VarChar(12)
  name            String            @db.VarChar(100)
  description     String?           @db.VarChar(500)
  status          String            @db.VarChar(20)
  createdAt       DateTime          @map("created_at") @db.DateTime(3)
  updatedAt       DateTime          @map("updated_at") @db.DateTime(3)
  archivedAt      DateTime?         @map("archived_at") @db.DateTime(3)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  members         ProjectMember[]
  milestones      Milestone[]
  environments    Environment[]
  testSuites      TestSuite[]
  vaultEntries    TestVaultEntry[]
  caseImports     TestCaseImport[]
  testCases       TestCase[]
  counters        SequenceCounter[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@map("projects")
}

model ProjectMember {
  id                String          @id @db.Char(36)
  workspaceId       String          @map("workspace_id") @db.Char(36)
  projectId         String          @map("project_id") @db.Char(36)
  workspaceMemberId String          @map("workspace_member_id") @db.Char(36)
  projectRole       String          @map("project_role") @db.VarChar(20)
  createdAt         DateTime        @map("created_at") @db.DateTime(3)
  updatedAt         DateTime        @map("updated_at") @db.DateTime(3)
  project           Project         @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  member            WorkspaceMember @relation(fields: [workspaceId, workspaceMemberId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, projectId, workspaceMemberId])
  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, workspaceMemberId])
  @@map("project_members")
}

model Milestone {
  testPlans   TestPlan[]
  testRuns    TestRun[]
  id          String     @id @db.Char(36)
  workspaceId String     @map("workspace_id") @db.Char(36)
  projectId   String     @map("project_id") @db.Char(36)
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(500)
  status      String     @db.VarChar(20)
  startDate   DateTime?  @map("start_date") @db.Date
  dueDate     DateTime?  @map("due_date") @db.Date
  completedAt DateTime?  @map("completed_at") @db.DateTime(3)
  createdAt   DateTime   @map("created_at") @db.DateTime(3)
  updatedAt   DateTime   @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime?  @map("deleted_at") @db.DateTime(3)
  project     Project    @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, projectId, deletedAt, status])
  @@map("milestones")
}

model Environment {
  vaultEntries TestVaultEntry[]
  category       String     @default("OTHER") @db.VarChar(20)
  defects        Defect[]
  testPlans      TestPlan[]
  testRuns       TestRun[]
  id             String     @id @db.Char(36)
  workspaceId    String     @map("workspace_id") @db.Char(36)
  projectId      String     @map("project_id") @db.Char(36)
  name           String     @db.VarChar(100)
  normalizedName String     @map("normalized_name") @db.VarChar(100)
  description    String?    @db.VarChar(500)
  active         Boolean
  createdAt      DateTime   @map("created_at") @db.DateTime(3)
  updatedAt      DateTime   @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?  @map("deleted_at") @db.DateTime(3)
  project        Project    @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, projectId, id])
  @@unique([workspaceId, projectId, normalizedName])
  @@index([workspaceId, projectId, deletedAt, active])
  @@map("environments")
}

model TestSuite {
  id            String      @id @db.Char(36)
  workspaceId   String      @map("workspace_id") @db.Char(36)
  projectId     String      @map("project_id") @db.Char(36)
  parentSuiteId String?     @map("parent_suite_id") @db.Char(36)
  name          String      @db.VarChar(100)
  description   String?     @db.Text
  position      Int
  createdAt     DateTime    @map("created_at") @db.DateTime(3)
  updatedAt     DateTime    @map("updated_at") @db.DateTime(3)
  archivedAt    DateTime?   @map("archived_at") @db.DateTime(3)
  project       Project     @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  parent        TestSuite?  @relation("SuiteTree", fields: [workspaceId, projectId, parentSuiteId], references: [workspaceId, projectId, id], onDelete: NoAction, onUpdate: NoAction)
  children      TestSuite[] @relation("SuiteTree")
  cases         TestCase[]

  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, projectId, parentSuiteId, archivedAt, position], map: "test_suites_tree_idx")
  @@map("test_suites")
}

model TestCase {
  planCases        TestPlanCase[]
  runCases         TestRunCase[]
  id               String               @id @db.Char(36)
  workspaceId      String               @map("workspace_id") @db.Char(36)
  projectId        String               @map("project_id") @db.Char(36)
  suiteId          String?              @map("suite_id") @db.Char(36)
  sequence         Int
  title            String               @db.VarChar(250)
  description      String?              @db.Text
  preconditions    String?              @db.Text
  postconditions   String?              @db.Text
  severity         String               @db.VarChar(20)
  priority         String               @db.VarChar(20)
  status           String               @db.VarChar(20)
  type             String               @db.VarChar(30)
  layer            String               @db.VarChar(20)
  behavior         String?              @db.VarChar(100)
  automationStatus String               @map("automation_status") @db.VarChar(30)
  createdBy        String               @map("created_by") @db.Char(36)
  version          Int
  createdAt        DateTime             @map("created_at") @db.DateTime(3)
  updatedAt        DateTime             @map("updated_at") @db.DateTime(3)
  archivedAt       DateTime?            @map("archived_at") @db.DateTime(3)
  project          Project              @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  suite            TestSuite?           @relation(fields: [workspaceId, projectId, suiteId], references: [workspaceId, projectId, id], onDelete: NoAction, onUpdate: NoAction)
  steps            TestStep[]
  tags             TestCaseTag[]
  attachments      TestCaseAttachment[]
  fieldValues      TestCaseFieldValue[]

  @@unique([workspaceId, projectId, id])
  @@unique([workspaceId, projectId, sequence])
  @@index([workspaceId, projectId, status])
  @@index([workspaceId, projectId, suiteId])
  @@map("test_cases")
}

model TestStep {
  id             String   @id @db.Char(36)
  workspaceId    String   @map("workspace_id") @db.Char(36)
  projectId      String   @map("project_id") @db.Char(36)
  testCaseId     String   @map("test_case_id") @db.Char(36)
  position       Int
  action         String   @db.Text
  testData       String?  @map("test_data") @db.Text
  expectedResult String?  @map("expected_result") @db.Text
  testCase       TestCase @relation(fields: [workspaceId, projectId, testCaseId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, projectId, id])
  @@unique([workspaceId, testCaseId, position])
  @@map("test_steps")
}

model TestCaseTag {
  id          String   @id @db.Char(36)
  workspaceId String   @map("workspace_id") @db.Char(36)
  projectId   String   @map("project_id") @db.Char(36)
  testCaseId  String   @map("test_case_id") @db.Char(36)
  tagId       String   @map("tag_id") @db.Char(36)
  testCase    TestCase @relation(fields: [workspaceId, projectId, testCaseId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  tag         Tag      @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, projectId, testCaseId, tagId], map: "test_case_tags_link_key")
  @@map("test_case_tags")
}

model TestCaseAttachment {
  id           String     @id @db.Char(36)
  workspaceId  String     @map("workspace_id") @db.Char(36)
  projectId    String     @map("project_id") @db.Char(36)
  testCaseId   String     @map("test_case_id") @db.Char(36)
  attachmentId String     @map("attachment_id") @db.Char(36)
  testCase     TestCase   @relation(fields: [workspaceId, projectId, testCaseId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  attachment   Attachment @relation(fields: [workspaceId, attachmentId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, projectId, testCaseId, attachmentId], map: "test_case_attachments_link_key")
  @@map("test_case_attachments")
}

model TestCaseFieldValue {
  id          String                @id @db.Char(36)
  workspaceId String                @map("workspace_id") @db.Char(36)
  projectId   String                @map("project_id") @db.Char(36)
  testCaseId  String                @map("test_case_id") @db.Char(36)
  fieldId     String                @map("field_id") @db.Char(36)
  value       Json
  testCase    TestCase              @relation(fields: [workspaceId, projectId, testCaseId], references: [workspaceId, projectId, id], onDelete: Restrict, onUpdate: NoAction)
  field       CustomFieldDefinition @relation(fields: [workspaceId, fieldId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, projectId, testCaseId, fieldId], map: "test_case_field_values_link_key")
  @@map("test_case_field_values")
}

model SequenceCounter {
  id          String  @id @db.Char(36)
  workspaceId String  @map("workspace_id") @db.Char(36)
  projectId   String  @map("project_id") @db.Char(36)
  entityType  String  @map("entity_type") @db.VarChar(30)
  nextValue   Int     @map("next_value")
  project     Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([workspaceId, projectId, entityType], map: "sequence_counters_scope_key")
  @@map("sequence_counters")
}

model TestPlan {
